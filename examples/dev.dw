import "dev_libs.dw"

func main( array & args )
{
	Animal animal = Animal::cat
	print(animal)
	print(animal.value)
	print(Animal::dog.value)

	int a = 7; int b = 7; & c = `int e`
		{ return (a * b) - e }
	print(c(1))

	Person person = Person{ name: "Ivan", fav_animal: animal }
	print(person)
}

enum Animal
{
	cat = ("very nice"
		@
		array)
	dog = "meh"
}

struct Person
{
	name: string
	fav_animal: Animal

	cast string {
		return "{self.name} likes {self.fav_animal.name}s"
	}
}
