func main() {
    array data = ["nice", string(5.1), "more strings"]
    data.forEach(`string& val`{
        print("value: {val}")
    })

    Counter? counter = Counter("My Counter")
    counter.incr()
    counter.decr().decr()
    print(counter)

    for v : [(), 2.3, "yeah"] {
        v.who()
    }
}

func array.forEach(function& f) {
    for v : self {
        f(v)
    }
}

func Counter.decr()
{
    self.value -= 1
    return self
}

struct Counter
{
    name : string
    value : int

    cast string {
        return "Counter [{self.name}] Value: {self.value}"
    }

    func incr()
    {
        self.value += 1
    }
}

func void.who()
{
    print("i am void :(")
}

func float.who()
{
    print("im a float")
}

func string.who()
{
    print("im a string!!")
}
